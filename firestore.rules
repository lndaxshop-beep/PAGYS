rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }
    match /projects/{projectId} {
      // Both tiers are paid products, so projects are created by the server only
      // (Admin SDK bypasses these rules) once Paystack confirms payment. There is
      // deliberately no `create` rule: without one, all writes are denied, so no
      // client can conjure a project without paying.
      // Restoring from the recycle bin goes through /api/restore-project for the
      // same reason.
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      // Clients may edit their own project content but must never escalate the tier,
      // hand the project to someone else, or self-declare a payment.
      // `.get(key, default)` keeps documents created before these fields existed
      // editable; reading a missing key directly would error and deny the update,
      // locking every pre-existing project out of edits.
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.get('userId', request.auth.uid) == resource.data.get('userId', request.auth.uid)
        && request.resource.data.get('tier', 'regular') == resource.data.get('tier', 'regular')
        && request.resource.data.get('isPremium', false) == resource.data.get('isPremium', false)
        && request.resource.data.get('paymentStatus', 'paid') == resource.data.get('paymentStatus', 'paid');
    }
    match /payments/{paymentId} {
      // Receipts are written only by the server (Admin SDK bypasses these rules)
      // after Paystack confirms payment. Clients may read their own history but
      // cannot create, edit or delete records.
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /deletedProjects/{projectId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /content/{projectId} {
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
    }
    match /chapters/{projectId} {
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
    }
    match /citations/{projectId} {
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
    }
    match /subsectionVersions/{projectId} {
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
    }
    match /visuals/{projectId} {
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
    }
  }
}
